rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read/write their own calc history
    match /users/{userId}/calc_history/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Anyone can read posts, authenticated users can write posts
    match /posts/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
